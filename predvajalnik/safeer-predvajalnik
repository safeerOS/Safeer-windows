#!/usr/bin/env python3
"""Safeer Predvajalnik — samostojna aplikacija za Linux (ista koda kot v Safeer OS za Windows).

Zahteve (Linux Mint / Ubuntu): libmpv2 (apt), python3-pyside6 ali `pip install PySide6`,
`pip install python-mpv==1.0.8`. Zagon: safeer-predvajalnik [datoteka|URL ...]
"""
import os
import sys

KOREN = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
for p in (os.path.join(KOREN, "windows"), KOREN):
    if p not in sys.path:
        sys.path.insert(0, p)

from safeer_windows.safeer_predvajalnik import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
